<UserControl
  x:Class="ACT.TTSYukkuri.Config.Views.VoicevoxConfigView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:wpf="clr-namespace:FFXIV.Framework.WPF;assembly=FFXIV.Framework"
  xmlns:fwcmn="clr-namespace:FFXIV.Framework.Common;assembly=FFXIV.Framework"
  xmlns:fwcnv="clr-namespace:FFXIV.Framework.WPF.Converters;assembly=FFXIV.Framework"
  xmlns:global="clr-namespace:FFXIV.Framework.Globalization;assembly=FFXIV.Framework"
  xmlns:local="clr-namespace:ACT.TTSYukkuri.Config.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:resources="clr-namespace:ACT.TTSYukkuri.resources"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:vm="clr-namespace:ACT.TTSYukkuri.Config.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:VoicevoxConfigViewModel, IsDesignTimeCreatable=True}"
  d:DesignWidth="600"
  Background="White"
  FontFamily="Consolas, Yu Gothic UI, Meiryo UI"
  FontSize="17"
  Margin="5"
  RenderOptions.BitmapScalingMode="HighQuality"
  RenderOptions.ClearTypeHint="Enabled"
  RenderOptions.EdgeMode="Unspecified"
  TextOptions.TextFormattingMode="Display"
  TextOptions.TextHintingMode="Animated"
  TextOptions.TextRenderingMode="ClearType"
  mc:Ignorable="d">

  <UserControl.Resources>
    <ResourceDictionary>
      <fwcnv:BoolToCollapsedConverter x:Key="VisibilityConverter" />
      <fwcnv:BoolToHiddenConverter x:Key="HiddenConverter" />

      <ResourceDictionary.MergedDictionaries>
        <wpf:DesignTimeResourceDictionary Source="../../../resources/strings/Strings.Yukkuri.ja-JP.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">

    <StackPanel Orientation="Vertical">
    <!-- API URL -->
    <Label Content="{DynamicResource Voicevox_ApiUrl}" />
    <StackPanel Orientation="Horizontal">
      <TextBox
        Width="400"
        HorizontalAlignment="Left"
        Text="{Binding Config.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
      <Button
        Margin="10,0,0,0"
        Padding="15,2"
        Content="{DynamicResource Voicevox_Reload}"
        Click="OnReloadClick" />
    </StackPanel>

    <!-- Speaker -->
    <Label Margin="0,10,0,0" Content="{DynamicResource Voicevox_Speaker}" />
    <ComboBox
      MinWidth="350"
      HorizontalAlignment="Left"
      ItemsSource="{Binding Speakers}"
      SelectedValuePath="Id"
      DisplayMemberPath="DisplayName"
      SelectedValue="{Binding Config.SpeakerId, Mode=TwoWay}" />

    <!-- Volume -->
    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
      <Label
        MinWidth="120"
        Margin="0,0,0,0"
        Content="{DynamicResource Voicevox_Volume}" />
      <Label
        MinWidth="60"
        Margin="5,0,0,0"
        HorizontalContentAlignment="Right"
        Content="{Binding ElementName=VolumeSlider, Path=Value, Mode=OneWay}"
        ContentStringFormat="F2" />
      <Slider
        x:Name="VolumeSlider"
        IsSnapToTickEnabled="True"
        TickFrequency="0.01"
        Width="250"
        Margin="5,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        LargeChange="0.1"
        Maximum="2.0"
        Minimum="0.0"
        SmallChange="0.01"
        Value="{Binding Config.VolumeScale, Mode=TwoWay}" />
    </StackPanel>

    <!-- Speed -->
    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
      <Label
        MinWidth="120"
        Margin="0,0,0,0"
        Content="{DynamicResource Voicevox_Speed}" />
      <Label
        MinWidth="60"
        Margin="5,0,0,0"
        HorizontalContentAlignment="Right"
        Content="{Binding ElementName=SpeedSlider, Path=Value, Mode=OneWay}"
        ContentStringFormat="F2" />
      <Slider
        x:Name="SpeedSlider"
        IsSnapToTickEnabled="True"
        TickFrequency="0.01"
        Width="250"
        Margin="5,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        LargeChange="0.1"
        Maximum="2.0"
        Minimum="0.5"
        SmallChange="0.01"
        Value="{Binding Config.SpeedScale, Mode=TwoWay}" />
    </StackPanel>

    <!-- Pitch -->
    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
      <Label
        MinWidth="120"
        Margin="0,0,0,0"
        Content="{DynamicResource Voicevox_Pitch}" />
      <Label
        MinWidth="60"
        Margin="5,0,0,0"
        HorizontalContentAlignment="Right"
        Content="{Binding ElementName=PitchSlider, Path=Value, Mode=OneWay}"
        ContentStringFormat="F2" />
      <Slider
        x:Name="PitchSlider"
        IsSnapToTickEnabled="True"
        TickFrequency="0.01"
        Width="250"
        Margin="5,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        LargeChange="0.01"
        Maximum="0.15"
        Minimum="-0.15"
        SmallChange="0.01"
        Value="{Binding Config.PitchScale, Mode=TwoWay}" />
    </StackPanel>

    <!-- Intonation -->
    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
      <Label
        MinWidth="120"
        Margin="0,0,0,0"
        Content="{DynamicResource Voicevox_Intonation}" />
      <Label
        MinWidth="60"
        Margin="5,0,0,0"
        HorizontalContentAlignment="Right"
        Content="{Binding ElementName=IntonationSlider, Path=Value, Mode=OneWay}"
        ContentStringFormat="F2" />
      <Slider
        x:Name="IntonationSlider"
        IsSnapToTickEnabled="True"
        TickFrequency="0.01"
        Width="250"
        Margin="5,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        LargeChange="0.1"
        Maximum="2.0"
        Minimum="0.0"
        SmallChange="0.01"
        Value="{Binding Config.IntonationScale, Mode=TwoWay}" />
    </StackPanel>

    <TextBlock
      Margin="5,20,5,0"
      HorizontalAlignment="Left"
      FontSize="14"
      TextWrapping="Wrap">
      <Run Text="{DynamicResource Voicevox_Description}" />
    </TextBlock>
      </StackPanel>
  </ScrollViewer>
</UserControl>
